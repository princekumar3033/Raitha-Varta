<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.raithavarta.app.ui.home.HomeFragment"
        android:label="@string/home">
    </fragment>

    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.raithavarta.app.ui.categories.CategoriesFragment"
        android:label="@string/categories">
        <action
            android:id="@+id/action_categories_to_categoryDetail"
            app:destination="@id/categoryDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/categoryDetailFragment"
        android:name="com.raithavarta.app.ui.categories.CategoryDetailFragment"
        android:label="{categoryName}">
        <argument
            android:name="category"
            app:argType="string" />
        <argument
            android:name="categoryName"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/expertAskFragment"
        android:name="com.raithavarta.app.ui.expert.ExpertAskFragment"
        android:label="@string/expert_ask">
    </fragment>

    <fragment
        android:id="@+id/storiesFragment"
        android:name="com.raithavarta.app.ui.stories.StoriesFragment"
        android:label="@string/stories">
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.raithavarta.app.ui.settings.SettingsFragment"
        android:label="@string/settings">
    </fragment>

</navigation>
